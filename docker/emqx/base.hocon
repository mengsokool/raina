# raina IoT Platform - EMQX Default Base Configuration
# Pre-configures HTTP token authentication and multi-tenant ACL webhooks

authentication = [
  {
    mechanism = password_based
    backend = http
    method = post
    url = "http://server:3001/v1/emqx/auth"
    headers {
      content-type = "application/json"
    }
    body {
      clientid = "${clientid}"
      username = "${username}"
      password = "${password}"
    }
  }
]

authorization {
  sources = [
    {
      type = http
      enable = true
      method = post
      url = "http://server:3001/v1/emqx/acl"
      headers {
        content-type = "application/json"
      }
      body {
        clientid = "${clientid}"
        username = "${username}"
        topic = "${topic}"
        action = "${action}"
      }
    },
    {
      type = file
      enable = true
      path = "${EMQX_ETC_DIR}/acl.conf"
    }
  ]
}
