# ==============================================================================
# raina IoT Cloud Platform - Environment Configuration Template
# Copy this file to .env before starting services locally
# ==============================================================================

# Database Configuration (PostgreSQL 17)
DATABASE_URL="postgresql://raina:rainasecret@localhost:5433/raina?schema=public"
POSTGRES_USER=raina
POSTGRES_PASSWORD=rainasecret
POSTGRES_DB=raina

# EMQX MQTT Broker Configuration
EMQX_BROKER_URL="mqtt://localhost:1883"
EMQX_API_URL="http://localhost:18083"
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=rainasecret
EMQX_SERVER_PASSWORD=raina-internal-broker-secret

# Backend Server Configuration
PORT=3001
NODE_ENV=production
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
PUBLIC_API_URL="http://localhost:3001"
PUBLIC_MQTT_HOST="localhost"
AUTO_MIGRATE=true
AUTO_SEED=false
TELEMETRY_RETENTION_DAYS=30

# Frontend Web Configuration
INTERNAL_API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_MQTT_HOST="localhost"
PUBLIC_MQTT_WS_URL="ws://localhost:8083/mqtt"
# NEXT_PUBLIC_WS_URL="ws://localhost:3001" # Optional: Custom WebSocket endpoint (defaults to NEXT_PUBLIC_API_URL)
