# ==============================================================================
# Raina IoT Cloud Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Local development and single-host Docker Compose work out-of-the-box with defaults.
# In production, replace all secret placeholders with strong random values.

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=development

# API server port (apps/server)
PORT=3001

# Allowed CORS origins for browser API requests (comma-separated or *)
# Development default allows localhost:3000, 127.0.0.1:3000, localhost:3001, 127.0.0.1:3001
CORS_ORIGIN=*

# Public canonical API URL (e.g. https://iot.example.com or http://localhost:3001)
# Used for cookie Secure attribute detection, client endpoints, and diagnostics.
# PUBLIC_API_URL=http://localhost:3001

# Cookie Domain attribute (optional; e.g. .example.com). Leave empty for same-host.
# COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 17 + TimescaleDB)
# ------------------------------------------------------------------------------
# Database credentials used by Docker Compose
POSTGRES_USER=raina
POSTGRES_PASSWORD=rainasecret
POSTGRES_DB=raina
POSTGRES_PORT=5432
# POSTGRES_IMAGE=timescale/timescaledb:2.30.0-pg17

# Full database connection string (required when running outside Docker Compose)
# In Docker Compose, this is automatically constructed from POSTGRES_* variables.
DATABASE_URL=postgresql://raina:rainasecret@127.0.0.1:5432/raina?schema=public

# Automatically synchronize Prisma database schema on server startup (true | false)
AUTO_MIGRATE=true

# Pre-populate sample smart farm greenhouse project, devices, and dashboards (true | false)
AUTO_SEED=false

# Enable TimescaleDB hypertable for telemetry time-series storage (true | false)
TIMESCALE_ENABLED=true

# Telemetry data retention period in days (0 to keep indefinitely)
TELEMETRY_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 3. Redis (Event Bus, Locks & Job Queue)
# ------------------------------------------------------------------------------
# Enable Redis for distributed Pub/Sub, RLP command routing, and Stream queue (true | false)
# Required for multi-instance deployments; optional for standalone local dev.
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Security & Cryptographic Secrets
# ------------------------------------------------------------------------------
# Secret key used for signing WebSocket tickets in authenticated dashboard sessions.
# Required in production. (Min 32 characters recommended)
WS_TICKET_SECRET=supersecretwskey

# Master key used by HKDF-AES-256-GCM to encrypt integration credentials at rest.
# In production, this must be set to a secure random secret.
# ENCRYPTION_KEY=replace-with-a-secure-random-32-byte-hex-or-string

# Optional fallback secret for WS_TICKET_SECRET and ENCRYPTION_KEY
# JWT_SECRET=replace-with-a-secure-random-secret

# Secret token required to bootstrap the first owner account in production mode.
# If empty in production, owner registration is locked until set.
# SETUP_TOKEN=replace-with-a-secure-random-setup-token

# ------------------------------------------------------------------------------
# 5. RLP Device Gateway (Raina Link Protocol - IoT Transport)
# ------------------------------------------------------------------------------
# Gateway listening host and port
RLP_HOST=0.0.0.0
RLP_PORT=9000

# Hostname and port advertised to IoT microcontrollers (ESP32, Arduino, MicroPython)
PUBLIC_RLP_HOST=127.0.0.1
PUBLIC_RLP_PORT=9000
PUBLIC_RLP_TLS=false

# Require TLS encryption for device connections (default: true in production, false in dev)
# RLP_REQUIRE_TLS=false
# RLP_TLS_CERT_PATH=/etc/raina/certs/server.crt
# RLP_TLS_KEY_PATH=/etc/raina/certs/server.key

# Require Redis for RLP command routing across instances (true | false)
RLP_REQUIRE_REDIS=true

# Distributed device lease timeout in milliseconds (minimum: 15000)
# RLP_DEVICE_LEASE_MS=45000

# Connection limits and buffer sizes
# RLP_MAX_CONNECTIONS=10000
# RLP_MAX_FRAME_SIZE=16384
# RLP_IDLE_TIMEOUT_MS=90000

# ------------------------------------------------------------------------------
# 6. Worker & Background Scheduler
# ------------------------------------------------------------------------------
# Enable the background automation scheduler and retention cleaner (true | false)
# Set to false on API replicas if running a dedicated worker process.
SCHEDULER_ENABLED=true

# ------------------------------------------------------------------------------
# 7. Frontend Web UI (apps/web)
# ------------------------------------------------------------------------------
# Internal server-side API URL used by the web frontend server to proxy /v1/*
INTERNAL_API_URL=http://127.0.0.1:3001

# Optional WebSocket URL override for browser client connections
# Defaults to current origin host or hostname:3001 in development
# VITE_WS_URL=wss://iot.example.com

# ------------------------------------------------------------------------------
# 8. Integrations & AI
# ------------------------------------------------------------------------------
# Optional: TypeSafe AI API key for natural language automation graph drafts
# TYPESAFE_API_KEY=

# ------------------------------------------------------------------------------
# 9. Reverse Proxy (Optional: Docker Compose --profile proxy)
# ------------------------------------------------------------------------------
# Public domain name handled by Caddy (e.g. iot.example.com). Defaults to :80
# DOMAIN=iot.example.com
