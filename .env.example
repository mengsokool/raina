# ==============================================================================
# Raina IoT Cloud Platform - Environment Configuration Template
# ==============================================================================
# All variables have defaults. You can run `docker compose up -d` directly.
# Copy this file to .env to customize passwords, ports, or domains.

# Database Configuration (PostgreSQL 17 + TimescaleDB)
POSTGRES_USER=raina
POSTGRES_PASSWORD=rainasecret
POSTGRES_DB=raina
POSTGRES_PORT=5432
# POSTGRES_IMAGE=timescale/timescaledb:2.30.0-pg17

# RLP device gateway (local development defaults to plaintext TCP on 9000).
# Production must use TLS and Redis; see DEPLOYMENT.md.
PUBLIC_RLP_HOST=127.0.0.1
PUBLIC_RLP_PORT=9000
PUBLIC_RLP_TLS=false

# Application & Security
CORS_ORIGIN=*
# SETUP_TOKEN=                 # Optional: Set a secret token required for first-time owner account creation
# AUTO_SEED=false              # Set to true to pre-populate demo farm dashboards & sensors
# TIMESCALE_ENABLED=true        # Use Timescale hypertable storage for telemetry
# TELEMETRY_RETENTION_DAYS=30   # Database retention policy for telemetry data
# TYPESAFE_API_KEY=             # Optional: Enables natural-language automation drafts (server-side only)

# Domain & Reverse Proxy (Optional: use when running with --profile proxy)
# DOMAIN=iot.yourdomain.com
