# Copy to raina.deploy.env, then set values for one GCP deployment.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast1
GCP_ZONE=asia-southeast1-b
GCP_MACHINE_TYPE=e2-medium
GCP_DISK_SIZE_GB=30
GCP_SSH_CIDR=203.0.113.10/32

RAINA_APP_DOMAIN=app.example.com
RAINA_API_DOMAIN=api.example.com
RAINA_MQTT_DOMAIN=mqtt.example.com

# The VM clones this public repository on its first boot.
RAINA_REPOSITORY_URL=https://github.com/mengsokool/raina.git
RAINA_REPOSITORY_REF=main
