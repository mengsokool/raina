# Copy to /etc/raina/raina.env and replace every CHANGE_ME value before starting.
# This file is read by native systemd services.

NODE_ENV=production

# Backend
PORT=3001
DATABASE_URL=postgresql://raina:CHANGE_ME@127.0.0.1:5432/raina?schema=public
TIMESCALE_ENABLED=true
TELEMETRY_RETENTION_DAYS=30
AUTO_MIGRATE=true
AUTO_SEED=false

# Redis & Event Bus
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

# Security & Secrets
WS_TICKET_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
ENCRYPTION_KEY=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
SETUP_TOKEN=CHANGE_ME_USE_A_LONG_RANDOM_VALUE

# RLP Device Gateway (IoT Transport)
RLP_PORT=9000
PUBLIC_RLP_HOST=127.0.0.1
PUBLIC_RLP_PORT=9000
PUBLIC_RLP_TLS=false
RLP_REQUIRE_REDIS=true

# External Integrations & AI (Optional)
TYPESAFE_API_KEY=

# Public URLs. Replace with the single HTTPS hostname served by Caddy/Nginx.
PUBLIC_API_URL=https://iot.example.com
CORS_ORIGIN=https://iot.example.com
COOKIE_DOMAIN=
# Optional build-time WebSocket origin. Defaults from PUBLIC_API_URL in install.sh.
# VITE_WS_URL=wss://iot.example.com

# Web server-side API target. This must remain private/loopback.
INTERNAL_API_URL=http://127.0.0.1:3001
