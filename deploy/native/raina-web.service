[Unit]
Description=Raina web dashboard
After=network-online.target raina-server.service
Wants=network-online.target

[Service]
Type=simple
User=raina
Group=raina
WorkingDirectory=/opt/raina/apps/web
EnvironmentFile=/etc/raina/raina.env
Environment=PORT=3000
ExecStart=/usr/bin/env node ./node_modules/@react-router/serve/dist/cli.js build/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
